4aoudh3HyHwqRROsRGn5x2DFOmeyE5h9Un0DGeDDGAkET66itvz0&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=instagram.fcpv16-1.fna&_nc_gid=XTmaqwrtVrDvNm9yLU8ULQ&_nc_ss=7a22e&oh=00_AQFda96ys1m8JmEjR_wobLFloigM_b7lp0wq_2_BSnG9eQ&oe=6A84FA6C","width":240},{"height":150,"url":"https:\/\/instagram.fcpv16-1.fna.fbcdn.net\/v\/t51.82787-15\/752524556_18151584451498755_7811460747893035329_n.jpg?stp=c0.458.1179.1179a_dst-jpg_e15_s150x150_tt6&_nc_cat=105&cb=30a688f7-1a5a3624&ig_cache_key=Mzk0NTUzMjk2NzMxMjQ1ODczMzE4MTUxNTg0NDQ1NDk4NzU1.3-ccb7-5-cb30a688f7-1a5a3624&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjExNzkuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ\u00253D\u00253D&_nc_ohc=Jk62MXJWP0cQ7kNvwHFzPZl&_nc_oc=AdqwJUFkYiJd_AB4aoudh3HyHwqRROsRGn5x2DFOmeyE5h9Un0DGeDDGAkET66itvz0&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=instagram.fcpv16-1.fna&_nc_gid=XTmaqwrtVrDvNm9yLU8ULQ&_nc_ss=7a22e&oh=00_AQFsseNQ7GYSys4C16hekpU54SJrXyeqwdzAr_hpyNAwYQ&oe=6A84FA6C","width":150}]},"code":"DbBWVRWQIPt","media_cropping_info":null,"profile_grid_thumbnail_fitting_style":"UNSET","media_overlay_info":null,"preview":null,"product_type":"clips","thumbnails":null,"timeline_pinned_user_ids":[],"upcoming_event":null,"user":{"pk":"14967426754","username":"barradesantanajucurutu","id":"14967426754"},"media_notes":{"items":[]},"like_count":297,"like_and_view_counts_disabled":false,"boosted_status":null,"boost_unavailable_identifier":null,"boost_unavailable_reason":null,"comment_count":8,"comments_disabled":null,"view_count":null,"id":"3945532967312458733_14967426754"}},{"media":{"pk":"3945496152848887995","accessibility_caption":null,"caption":{"pk":"17866487412638198","text":"Uma noite que vai ficar marcada em nossos cora\u00e7\u00f5es! \ud83e\udd0d\u2728\n\n\u200bA Nova Barra de Santana, em Jucurutu\/RN, foi palco de um verdadeiro derramamento de gra\u00e7as com o show da Banda Kyrie. Que alegria ver a nossa comunidade reunida, louvando e bendizendo ao Senhor em uma noite repleta de b\u00ean\u00e7\u00e3os, m\u00fasica boa e profunda ora\u00e7\u00e3o.\n\n\u200bQuando a m\u00fasica cat\u00f3lica nos conduz ao altar do Senhor, o c\u00e9u se abre!\n\n#bandakyrie #m\u00fasicacat\u00f3lica #f\u00e9 #louvor #kyrie"},"audience":null,"carousel_media_count":null,"display_uri":null,"media_type":2,"carousel_media":null,"image_versions2":{"candidates":[{"height":2294,"url":"https:\/\/instagram.fcpv16-1.fna.fbcdn.net\/v\/t51.82787-15\/751224854_17928775464363515_4596703784799656688_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=109&cb=30a688f7-1a5a3624&ig_cache_key=Mzk0NTQ5NjE1Mjg0ODg4Nzk5NTE3OTI4Nzc1NDU4MzYzNTE1.3-ccb7-5-cb30a688f7-1a5a3624&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEyOTAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ\u00253D\u00253D&_nc_ohc=0JPDBdvVf1YQ7kNvwENJSqk&_nc_oc=AdpEWLmplT_Uy1F0ReR7I2cJSxyegleYT7hdRRuazGF91-bfDyAn2fS7fLK2UtzC9rw&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=instagram.fcpv16-1.fna&_nc_gid=XTmaqwrtVrDvNm9yLU8ULQ&_nc_ss=7a22e&oh=00_AQEWPCivx1SQ1m7LGpD_x0p8KRmEhbA_Db54VQLWsm4azg&oe=6A84E474","width":1290},{"height":1921,"url":"https:\/\/instagram.fcpv16-1.fna.fbcdn.net\/v\/t51.82787-15\/751224854_17928775464363515_4596703784799656688_n.jpg?stp=dst-jpg_e35_p1080x1080_sh2.08_tt6&_nc_cat=109&cb=30a688f7-1a5a3624&ig_cache_key=Mzk0NTQ5NjE1Mjg0ODg4Nzk5NTE3OTI4Nzc1NDU4MzYzNTE1.3-ccb7-5-cb30a688f7-1a5a3624&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjEyOTAuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ\u00253D\u00253D&_nc_ohc=0JPDBdvVf1YQ7kNvwENJSqk&_nc_oc=AdpEWLmplT_Uy1F0ReR7I2cJSxyegleYT7hdRRuazGF91-bfDyAn2fS7fLK2UtzC9rw&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=instagram.fcpv16-1.fna&_nc_gid=XTmaqwrtVrDvNm9yLU8ULQ&_nc_ss=7a22e&oh=00_AQFCyj8tLenJOvtPfJpnN3cfPRnQ-p4nlNfDrDNWUpmJ1g&oe=6A84E474","width":1080},{"height":1280,"url":"https:\/\/instagram.fcpv16-1.fna.fbcdn.net\/v\/t51.82787-15\/751224854_17928775464363515_4596703784799656688_n.jpg?stp=dst-jpg_e35_p720x720_sh2.08_tt6&_nc_cat=109&cb=30a688f7-1a5a3624&ig_cache_key=Mzk0