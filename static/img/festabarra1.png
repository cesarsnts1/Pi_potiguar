d&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjExNzkuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ\u00253D\u00253D&_nc_ohc=8jaC4Biu2SAQ7kNvwFdmeDS&_nc_oc=AdpnAPM32a4ErXbLhMgGOqJPutmdnGIITj9wUHsa7RzuZNDg417-_tYmjpzIXy0eIn4&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=instagram.fcpv16-1.fna&_nc_gid=XTmaqwrtVrDvNm9yLU8ULQ&_nc_ss=7a22e&oh=00_AQGfU7Va3lqVLYV4JDcgXvk5EMGYBVymmrk5QQHy-t2P2Q&oe=6A84F3D8","width":150}]},"code":"DMGFLP7s_vR","media_cropping_info":null,"profile_grid_thumbnail_fitting_style":"UNSET","media_overlay_info":null,"preview":null,"product_type":"clips","thumbnails":null,"timeline_pinned_user_ids":["14967426754"],"upcoming_event":null,"user":{"pk":"14967426754","username":"barradesantanajucurutu","id":"14967426754"},"media_notes":{"items":[]},"like_count":103,"like_and_view_counts_disabled":false,"boosted_status":null,"boost_unavailable_identifier":null,"boost_unavailable_reason":null,"comment_count":7,"comments_disabled":null,"view_count":null,"id":"3676648909049166801_14967426754"}},{"media":{"pk":"3950127829239491790","accessibility_caption":null,"caption":{"pk":"18159829942488455","text":"Neste dia dedicado a Sant\u2019Ana, elevamos nossas preces com gratid\u00e3o e esperan\u00e7a. Que ela continue intercedendo por nossa comunidade, fortalecendo nossa f\u00e9, unindo nossas fam\u00edlias e nos conduzindo pelos caminhos do amor, da paz e da solidariedade.\nQue Sant\u2019Ana derrame abundantes b\u00ean\u00e7\u00e3os sobre cada lar, proteja nossas crian\u00e7as, nossos idosos, nossos trabalhadores e todos aqueles que fazem parte da nossa querida comunidade. Que, sob sua maternal intercess\u00e3o, nunca nos faltem coragem, sa\u00fade e esperan\u00e7a.\n\nViva Sant\u2019Ana! \ud83d\ude4f\u2764\ufe0f\nFoto: Erick Santos"},"audience":null,"carousel_media_count":null,"display_uri":null,"media_type":1,"carousel_media":null,"image_versions2":{"candidates":[{"height":2347,"url":"https:\/\/instagram.fcpv16-1.fna.fbcdn.net\/v\/t51.82787-15\/758488615_18152212495498755_2