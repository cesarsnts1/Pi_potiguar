<script type="application/json" data-content-len="71301" data-sjs="" data-processed="1">{"require":[["ScheduledServerJS","handle",null,[{"__bbox":{"require":[["RelayPrefetchedStreamCache","next",[],["adp_PolarisDesktopPostPageRelatedMediaGridQueryRelayPreloader_6a7f1ba795cd37c28652009",{"__bbox":{"complete":true,"result":{"data":{"xdt_api__v1__profile_timeline":{"profile_grid_items":[{"media":{"pk":"3676648909049166801","accessibility_caption":null,"caption":{"pk":"18149481094389484","text":"Gratid\u00e3o, Sant\u2019Ana e S\u00e3o Joaquim! \ud83d\ude4f\u2728\nEncerramos a festa em paz e com o cora\u00e7\u00e3o cheio de f\u00e9. Obrigada a todos que participaram e prestigiaram nossas novenas e celebra\u00e7\u00f5es. Que sua prote\u00e7\u00e3o e amor esteja sempre conosco, e que nossa f\u00e9 seja fortalecida a cada passo. \n#barradesantanajucurutu #festadesant\u2019ana2025 #novabarradesantana"},"audience":null,"carousel_media_count":null,"display_uri":null,"media_type":2,"carousel_media":null,"image_versions2":{"candidates":[{"height":2096,"url":"https:\/\/instagram.fcpv16-1.fna.fbcdn.net\/v\/t51.82787-15\/520239848_18113698234498755_5521336969367524274_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=111&cb=30a688f7-1a5a3624&ig_cache_key=MzY3NjY0ODkwOTA0OTE2NjgwMQ\u00253D\u00253D.3-ccb7-5-cb30a688f7-1a5a3624&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjExNzkuc2RyLnZpZGVvX2RlZmF1bHRfY292ZXJfZnJhbWUuQzMifQ\u00253D\u00253D&_nc_ohc=8jaC4Biu2SAQ7kNvwFdmeDS&_nc_oc=AdpnAPM32a4ErXbLhMgGOqJPutmdnGIITj9wUHsa7RzuZNDg417-_tYmjpzIXy0eIn4&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=instagram.fcpv16-1.fna&_nc_gid=XTmaqwrtVrDvNm9yLU8ULQ&_nc_ss=7a22e&oh=00_AQH3Hr4xov8ETajdtI7doVQUF1AJ6ySIrfEqlcriGituUg&oe=6A84F3D8","width":1179},{"height":1280,"url":"https:\/\/instagram.fcpv16-1.fna.fbcdn.net\/v\/t51.82787-15\/520239848_18113698234498755_5521336969367524274_n.jpg?stp=dst-jpg_e35_p720x720_sh2.08_tt6&_nc_cat=111&cb=30a688f7-1a5a3624&ig_cache_key=MzY3NjY0ODkwOTA0OTE2NjgwMQ\u00253D\u0025