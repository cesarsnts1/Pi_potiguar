EOOrtoJjwkBmnX0-LLVOeSsa33t5KIn0jDDkUIKT1STfgmXZAmkPbHvxZCGjsI&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=instagram.fcpv16-1.fna&_nc_gid=XTmaqwrtVrDvNm9yLU8ULQ&_nc_ss=7a22e&oh=00_AQFgWJlsVh1u7V2UVcylf5R69KNgrBV4WR7l8hGz2WnRFA&oe=6A84E9DD","width":240},{"height":150,"url":"https:\/\/instagram.fcpv16-1.fna.fbcdn.net\/v\/t51.82787-15\/758488615_18152212495498755_2793949015054547337_n.jpg?stp=c0.293.1760.1760a_dst-jpg_e35_s150x150_tt6&_nc_cat=102&ig_cache_key=Mzk1MDEyNzgyOTIzOTQ5MTc5MA\u00253D\u00253D.3-ccb7-5&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkZFRUQueHBpZHMuMTc2MC5zZHIucmVndWxhcl9waG90by5DMyJ9&_nc_ohc=1Og5MKkL8LgQ7kNvwF3F8Fz&_nc_oc=AdqrUEOOrtoJjwkBmnX0-LLVOeSsa33t5KIn0jDDkUIKT1STfgmXZAmkPbHvxZCGjsI&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=instagram.fcpv16-1.fna&_nc_gid=XTmaqwrtVrDvNm9yLU8ULQ&_nc_ss=7a22e&oh=00_AQHQBQ3I2XdUWk0lxG_itpWIzoMez4I5FVfUkqz3BXpKVw&oe=6A84E9DD","width":150}]},"code":"DbRrFT_NGzO","media_cropping_info":null,"profile_grid_thumbnail_fitting_style":"UNSET","media_overlay_info":null,"preview":null,"product_type":"feed","thumbnails":null,"timeline_pinned_user_ids":[],"upcoming_event":null,"user":{"pk":"14967426754","username":"barradesantanajucurutu","id":"14967426754"},"media_notes":{"items":[]},"like_count":124,"like_and_view_counts_disabled":false,"boosted_status":null,"boost_unavailable_identifier":null,"boost_unavailable_reason":null,"comment_count":1,"comments_disabled":null,"view_count":null,"id":"3950127829239491790_14967426754"}},{"media":{"pk":"3947310355517002717","accessibility_caption":null,"caption":{"pk":"18110038480791723","text":"Antes de qualquer passo, h\u00e1 um caminho de f\u00e9. A prociss\u00e3o de Sant\u2019Ana \u00e9 o momento em que o povo deixa suas casas para caminhar unido, levando no cora\u00e7\u00e3o a gratid\u00e3o, os pedidos e a esperan\u00e7a.\n\u00c9 a express\u00e3o viva da devo\u00e7\u00e3o de gera\u00e7\u00f5es que, ano ap\u00f3s ano, renovam sua confian\u00e7a na padroeira. Cada ora\u00e7\u00e3o, cada canto e cada passo lembram que, mesmo diante das dificuldades, Deus caminha com o seu povo pela intercess\u00e3o de Sant\u2019Ana.\nQue esta prociss\u00e3o fortale\u00e7a nossa f\u00e9, una nossas fam\u00edlias e renove em cada cora\u00e7\u00e3o o compromisso de viver o Evangelho com amor, humildade e perseveran\u00e7a.\nViva Sant\u2019Ana! \ud83d\ude4f\ud83c\udf39\n\n#santana #padroeira #barradesantana"},"audience":null,"carousel_media_count":null,"display_uri":null,"media_type":2,"carousel_media":null,"image_versions2":{"candidates":[{"height":1024,"url":"https:\/\/instagram.fcpv16-1.fna.fbcdn.net\/v\/t51.82787-15\/755867851_18151820389498755_6743145699709157647_n.jpg?stp=dst-jpg_e15_tt6&_nc_cat=103&cb=30a688f7-1a5a3624&ig_cache_key=Mzk0NzMxMDM1NTUxNzAwMjcxNzE4MTUxODIwMzg2NDk4NzU1.3-ccb7-5-cb30a688f7-1a5a3624&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjU3Ni5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=tHcVo-oLjw4Q7kNvwG4flvQ&_nc_oc=AdqLoCCWumyGLHK7nlZaDMVhx05W55E6ev2UHjV5zd1wtOe_eLv4g4CmwxsoJ1cIjSE&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=instagram.fcpv16-1.fna&_nc_gid=XTmaqwrtVrDvNm9yLU8ULQ&_nc_ss=7a22e&oh=00_AQFXz6MeK4pHQo6gYZTrjQKshfCWQ26OQWjD2RS2wcevqg&oe=6A85031F","width":576},{"height":853,"url":"https:\/\/instagram.fcpv16-1.fna.fbcdn.net\/v\/t51.82787-15\/755867851_18151820389498755_6743145699709157647_n.jpg?stp=dst-jpg_e15_p480x480_tt6&_nc_cat=103&cb=30a688f7-1a5a3624&ig_cache_key=Mzk0NzMxMDM1NTUxNzAwMjcxNzE4MTUxODIwMzg2NDk4NzU1.3-ccb7-5-cb30a688f7-1a5a3624&ccb=7-5&_nc_sid=58cdad&efg=eyJ2ZW5jb2RlX3RhZyI6IkNMSVBTLnhwaWRzLjU3Ni5zZHIudmlkZW9fZGVmYXVsdF9jb3Zlcl9mcmFtZS5DMyJ9&_nc_ohc=tHcVo-oLjw4Q7kNvwG4flvQ&_nc_oc=AdqLoCCWumyGLHK7nlZaDMVhx05W55E6ev2UHjV5zd1wtOe_eLv4g4CmwxsoJ1cIjSE&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=instagram.fcpv16-1.fna&_nc_gid=XTmaqwrtVrDvNm9yLU8ULQ&_nc_ss=7a22e&oh=00_AQG_X__W4f5zij64keWMPHzFiehifoOfFYOfB5DsLy5dug&oe=6A85031F","width":480},{"height":569,"url":"https:\/\/instagram.fcpv16-1.fna.fbcdn.net\/v\/t51.82787