# Copie este arquivo para .env e preencha com os dados do Aiven.
MYSQL_HOST=seu-host.aivencloud.com
MYSQL_PORT=3306
MYSQL_USER=seu-usuario
MYSQL_PASSWORD=sua-senha
MYSQL_DATABASE=nome-do-banco

# O banco já existe no Aiven.
AUTO_CREATE_DATABASE=false

# Salve o certificado CA (por exemplo, ca.pem) na raiz do projeto.
MYSQL_SSL_CA=ca.pem
MYSQL_SSL_VERIFY_CERT=true
